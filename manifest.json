{
  "manifest_version": 3,
  "name": "add-on-ytb",
  "version": "1.0.0",
  "description": "Masque le contenu indésirable sur youtube",
  "browser_specific_settings": {
    "gecko": {
      "id": "add-on-ytb@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
